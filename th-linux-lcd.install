post_install() {
    echo "==> USB access is granted automatically to the user logged in at the seat"
    echo "    (udev uaccess). Re-plug the cooler's USB cable if it was already connected."
    echo "==> Enable the background daemon for your user:"
    echo "      systemctl --user enable --now th-linux-lcd"
    echo "    Or just launch the app; it starts the daemon automatically."
}

post_upgrade() {
    echo "==> Restart the daemon to use the new version:"
    echo "      systemctl --user restart th-linux-lcd"
}

pre_remove() {
    echo "==> Each user who enabled the daemon should run:"
    echo "      systemctl --user disable --now th-linux-lcd"
}
